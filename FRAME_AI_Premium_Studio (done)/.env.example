# FRAME AI Studio Configuration
PORT=8000

# Google Gemini API Key (Get your key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Enable fallback demo mode if no API key is provided
DEMO_MODE=true

# Google OAuth 2.0 Credentials for "Continue with Google"
# Obtain Client ID & Secret from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript Origins: http://localhost:8000
# Authorized Redirect URIs: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
